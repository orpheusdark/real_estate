{
  "name": "estateiq",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend",
    "check": "npm run check -w frontend",
    "start": "npm run start -w backend",
    "format": "prettier --write .",
    "test:browser": "npm run test:browser -w frontend",
    "test:mongo": "node scripts/test-mongo.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "mongodb-memory-server-core": "^11.3.0",
    "prettier": "^3.9.10"
  }
}
