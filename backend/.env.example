# Explicit demo mode: persistent JSON, local images, local email outbox. NEVER use in production.
DEMO_MODE=true
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# Production requires DEMO_MODE=false and every service below.
MONGODB_URI=
JWT_SECRET=
IMAGEKIT_PRIVATE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EstateIQ <hello@example.com>
# Set 1 only behind a trusted single reverse proxy such as Render.
TRUST_PROXY=0
